# ─── Required ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in ONLY the keys marked REQUIRED.
# Everything else has working defaults for local Docker dev.

# Anthropic Claude (REQUIRED — get key at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ─── Optional (leave blank to disable that feature locally) ───────────────────

# ElevenLabs — AI reads questions aloud (optional, app works without it)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Stripe — payments (not needed for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── DO NOT CHANGE THESE FOR LOCAL DOCKER DEV ─────────────────────────────────
# These are wired directly in docker-compose.yml.
# AWS keys below are IGNORED locally — LocalStack uses fake credentials "test/test".

DB_HOST=postgres
DB_PORT=5432
DB_NAME=intervai
DB_USERNAME=intervai
DB_PASSWORD=intervai_password
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=local_dev_secret_key_change_in_prod_1234567890abcdef
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=intervai-recordings
MAIL_HOST=mailhog
MAIL_PORT=1025
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/ws
